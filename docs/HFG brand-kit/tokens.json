{
  "$description": "Hash For Gamers brand tokens. Source of truth for web, app and marketing. Keep in sync with src/app/globals.css.",
  "color": {
    "pink": { "value": "#ff3d8b", "use": "Primary accent, hover fills, highlights, CTA hover" },
    "orange": { "value": "#ff9a3d", "use": "Eyebrows, numbers, links, secondary accent" },
    "yellow": { "value": "#ffd23d", "use": "End of the brand gradient, glints" },
    "purple": { "value": "#7c3aed", "use": "Franchise path, glows" },
    "lilac": { "value": "#a78bfa", "use": "Secondary purple, VR in charts" },
    "green": { "value": "#16ff7a", "use": "Success, positive numbers, live badges" },
    "red": { "value": "#ff6b6b", "use": "Losses, errors" },
    "sky": { "value": "#38bdf8", "use": "Consoles in charts, tertiary data" },
    "black": { "value": "#000000", "use": "Base background" },
    "night": { "value": "#0b0414", "use": "Alternate section background (deep purple-black)" },
    "white": { "value": "#ffffff", "use": "Primary text on dark; secondary text at 75%, 60%, 45% opacity" }
  },
  "gradient": {
    "brand": { "value": "linear-gradient(90deg, #ff3d8b 0%, #ff9a3d 50%, #ffd23d 100%)", "use": "Headline second line, primary emphasis, closing CTA background" },
    "gamer": { "value": "linear-gradient(135deg, #ff3d8b, #ff9a3d)" },
    "cafe": { "value": "linear-gradient(135deg, #ff9a3d, #ffd23d)" },
    "franchise": { "value": "linear-gradient(135deg, #7c3aed, #ff3d8b)" }
  },
  "font": {
    "display": { "family": "Anton", "use": "Headlines and big numbers. Always UPPERCASE, line-height 0.85 to 0.9." },
    "body": { "family": "Inter", "use": "Paragraphs, form fields, table text. Sentence case, line-height 1.6 to 1.75." },
    "tech": { "family": "Orbitron", "weight": 600, "use": "HUD-style detail text only: eyebrows, kickers, nav links, stat captions, chart labels. UPPERCASE, 10 to 11px, letter-spacing 0.2 to 0.3em." }
  },
  "typeScale": {
    "hero": "clamp(3.2rem, 9-13vw, 8-13rem)",
    "section": "3.75rem mobile / 6rem desktop (text-6xl / text-8xl)",
    "card": "1.875 to 3rem (text-3xl to text-5xl)",
    "body": "1rem to 1.125rem",
    "small": "0.875rem",
    "label": "10 to 11px Orbitron"
  },
  "radius": { "pill": "9999px (all buttons)", "card": "16px (rounded-2xl)", "tile": "2px (feature tiles)", "frame": "12px (browser and device frames)" },
  "motion": {
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeWipe": "cubic-bezier(0.76, 0, 0.24, 1)",
    "durations": { "micro": "300ms", "reveal": "800-900ms", "wipe": "1100ms" },
    "stagger": "60-120ms between siblings",
    "reducedMotion": "Every animation must be disabled under prefers-reduced-motion."
  },
  "layout": { "maxWidth": "1600px (landing), 1500px (inner pages), 1300px (legal)", "gutter": "16px mobile / 32px desktop", "sectionPadding": "96px vertical" }
}
