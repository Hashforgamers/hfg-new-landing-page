# Copy to .env.local for development. Generate secrets with:
#   node scripts/generate-secure-keys.mjs
# Server-only values go in the hosting provider's secret store, never in git.

# --- Secure gateway (server-only) ---
HFG_SECURE_IDENTITY_PRIVATE_KEY=
HFG_SECURE_TICKET_KEYS=
HFG_SESSION_COOKIE_KEYS=
HFG_LOG_SALT=
# Extra allowed browser origins (comma separated). hashforgamers.co.in is built in.
HFG_ALLOWED_ORIGINS=
# Preview deployments only: accept the request's own host as origin.
HFG_ALLOW_SAME_HOST_ORIGIN=false

# --- Secure gateway (public, pinned by the browser; comma separate during rotation) ---
NEXT_PUBLIC_HFG_SECURE_PINS=

# --- Shared rate-limit / replay store (recommended in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- HFG backends ---
HFG_USER_ONBOARD_URL=https://hfg-user-onboard.onrender.com
HFG_BOOKING_URL=https://hfg-booking.onrender.com
# Backend bearer tokens are minted like the HFG app does. Must equal JWT_SECRET_KEY on hfg-booking / hfg-user-onboard.
HFG_SERVICE_JWT_SECRET=
# Optional: backend RSA public key (PEM, \n escaped). Defaults to the key shipped in the app.
# HFG_SERVICE_PUBLIC_KEY=
HFG_VENDOR_URL=https://hfg-onboard.onrender.com
HASH_MEDUSA_URL=https://hash-medusa.onrender.com
# HMAC shared with hfg-user-onboard WEB_GATEWAY_HMAC_SECRETS (enables the hardened login path).
HFG_GATEWAY_HMAC_SECRET=
HFG_GATEWAY_KEY_ID=web-1
# "legacy" forces the app-compatible /users/fid path even if the HMAC secret is set.
HFG_AUTH_MODE=

# --- Payments (public Razorpay key id; must match hfg-booking's RAZORPAY_KEY_ID) ---
RAZORPAY_KEY_ID=

# --- Firebase Auth: defaults to the site's "Hash-website" web app in src/lib/site.js (project hash-ee6fc).
# Override only for another environment.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=hash-ee6fc

# --- Search engines ---
# IndexNow key (8-128 letters/digits/dashes), served at /indexnow-key.txt.
INDEXNOW_KEY=
# Bearer secret for POST /api/seo/indexnow (backends call it when a cafe or product is listed).
SEO_PING_SECRET=
# Vercel sets this for its cron; the daily job resubmits every cafe and product URL.
CRON_SECRET=

# --- Analytics (optional; events always go to structured logs) ---
SEGMENT_WRITE_KEY=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
ANALYTICS_RAW_USER_ID=false
